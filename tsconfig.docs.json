{
  // Program used only by TypeDoc for the docs site (site/typedoc.json). Extends the Nuxt-generated server
  // config so route handlers see auto-imports and the #shared / #server aliases.
  "extends": "./.nuxt/tsconfig.server.json",
  "include": [
    "./.nuxt/types/nitro-nuxt.d.ts",
    "./.nuxt/types/nitro.d.ts",
    "./server/**/*",
    "./shared/**/*"
  ],
  "exclude": [
    "./node_modules",
    "./server/db/migrations",
    "./**/*.test.ts"
  ]
}
