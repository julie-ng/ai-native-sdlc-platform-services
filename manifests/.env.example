# Copy to manifests/.env (gitignored) and replace the placeholders. Not secrets, but this
# repository is public, so real resource names stay out of it.
AZURE_ACR_NAME=myregistry
# Server name only, without .postgres.database.azure.com
POSTGRES_SERVER=my-postgres-server
ARTIFACT_STORAGE_ACCOUNT_URL=https://mystorageaccount.blob.core.windows.net
ARTIFACT_STORAGE_CONTAINER=artifacts
