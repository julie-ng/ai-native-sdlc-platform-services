{
  "compilerOptions": {
    "target": "ES2023",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "shared/**/*.ts",
    "server/utils/**/*.ts",
    "tests/support/**/*.ts",
    "docs/api/artifact-ports.ts",
    "scripts/artifact-openapi.ts",
    "scripts/generate-artifact-openapi.ts"
  ]
}
