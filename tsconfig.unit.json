{
  "compilerOptions": {
    "target": "ES2023",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "shared/**/*.ts",
    "server/utils/**/*.ts",
    "server/db/**/*.ts",
    "tests/support/**/*.ts",
    "scripts/generate-artifact-openapi.ts",
    "scripts/openapi/**/*.ts",
    "tests/contract/**/*.ts",
    "tests/integration/**/*.ts",
    "drizzle.config.ts",
    "vitest.config.ts"
  ]
}
